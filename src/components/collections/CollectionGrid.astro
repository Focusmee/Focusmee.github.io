---
import CollectionCard from "./CollectionCard.astro";
import { collections } from "../../data/collections";
import { getPublishedLogs } from "../../utils/posts";

const posts = await getPublishedLogs();
---

<div class="card-grid">
  {
    collections.map((collection) => {
      const items =
        collection.id === "archive"
          ? posts
          : posts.filter((entry) => entry.data.category === collection.id);

      return (
        <CollectionCard
          collection={collection}
          count={items.length}
          latestTitle={items[0]?.data.title}
        />
      );
    })
  }
</div>
