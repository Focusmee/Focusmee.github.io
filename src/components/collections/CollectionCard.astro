---
import type { CollectionMeta } from "../../data/collections";
import { withBase } from "../../utils/links";

interface Props {
  collection: CollectionMeta;
  count: number;
  latestTitle?: string;
}

const { collection, count, latestTitle } = Astro.props as Props;
---

<article class="collection-card">
  <div class="collection-card__meta">
    <span>旧栏目</span>
    <span>{count} 篇</span>
  </div>
  <h2><a href={withBase(collection.href)}>{collection.title}</a></h2>
  <p>{collection.description}</p>
  {latestTitle && <small>最近：{latestTitle}</small>}
</article>
