---
import { formatDate, getReadingMinutes } from "../../utils/format";
import { withBase } from "../../utils/links";
import type { LogEntry } from "../../utils/posts";

interface Props {
  entry: LogEntry;
  index?: number;
}

const { entry, index = 1 } = Astro.props as Props;
const readingMinutes = getReadingMinutes(entry.body ?? "");
---

<article class="post-item">
  <span class="post-item__index" aria-hidden="true">
    {String(index).padStart(2, "0")}
  </span>

  <div class="post-item__meta">
    <time datetime={entry.data.pubDate.toISOString()}>
      {formatDate(entry.data.pubDate)}
    </time>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes} 分钟阅读</span>
  </div>

  <div class="post-item__content">
    <h3>
      <a href={withBase(`/logs/${entry.id}`)}>{entry.data.title}</a>
    </h3>
    <p>{entry.data.description}</p>
    {entry.data.tags.length > 0 && (
      <p class="post-item__tags" aria-label="标签">
        {entry.data.tags.slice(0, 3).join(" / ")}
      </p>
    )}
  </div>

  <a
    class="post-item__arrow"
    href={withBase(`/logs/${entry.id}`)}
    aria-label={`阅读《${entry.data.title}》`}
  >
    ↗
  </a>
</article>
