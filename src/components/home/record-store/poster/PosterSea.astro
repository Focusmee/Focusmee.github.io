<div class="poster-layer poster-sea" data-poster-layer="sea">
  <div class="sea-horizon"></div>
  <div class="sea-stripe sea-stripe--one"></div>
  <div class="sea-stripe sea-stripe--two"></div>
  <div class="sea-stripe sea-stripe--three"></div>
  <div class="sea-stripe sea-stripe--four"></div>
  <div class="sea-line sea-line--one"></div>
  <div class="sea-line sea-line--two"></div>
  <div class="sea-line sea-line--three"></div>
  <div class="sea-line sea-line--four"></div>
  <div class="sea-line sea-line--five"></div>
  {
    Array.from({ length: 12 }).map((_, index) => (
      <span
        class="sea-sparkle"
        style={`--spark-x:${6 + index * 8}%;--spark-y:${22 + (index % 4) * 15}%;--spark-w:${2 + (index % 3) * 1.4}rem`}
      ></span>
    ))
  }
  <div class="sailboat sailboat--left">
    <span></span>
  </div>
  <div class="sailboat sailboat--right">
    <span></span>
  </div>
</div>
