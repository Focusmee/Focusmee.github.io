---
import RecordStoreDialog from "../RecordStoreDialog";
import RecordStoreInteriorScene from "../RecordStoreInteriorScene.astro";
import RecordStoreScrollController from "../RecordStoreScrollController";
import PosterAssetDefs from "./PosterAssetDefs.astro";
import PosterBacklot from "./PosterBacklot.astro";
import PosterEffects from "./PosterEffects.astro";
import PosterRoad from "./PosterRoad.astro";
import PosterSea from "./PosterSea.astro";
import PosterSky from "./PosterSky.astro";
import RecordStoreBuilding from "./RecordStoreBuilding.astro";

type DialogChoice = {
  id: string;
  title: string;
  href: string;
  detail: string;
};

interface Props {
  rootId: string;
  choices: DialogChoice[];
}

const { rootId, choices } = Astro.props as Props;
---

<div class="record-store-app-shell" data-record-store-app>
  <div class="record-store-app-window" data-record-store-pin-target>
    <div class="record-store-app-titlebar">
      <div class="record-store-app-titlebar__controls" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="record-store-app-titlebar__title" aria-hidden="true">
        <span></span>
        <strong>Seaside Records.app</strong>
      </div>
      <button
        class="record-store-app-titlebar__back"
        data-record-store-close-trigger
        type="button"
        aria-label="Return to Seaside OS desktop"
      >
        <span aria-hidden="true">&lt;</span>
        Desktop
      </button>
    </div>

    <div class="record-store-scroll-stage" data-record-store-stage>
      <div
        class="record-store-poster"
        data-record-store-poster
        aria-label="A layered seaside record store poster"
      >
        <PosterAssetDefs />
        <PosterSky />
        <PosterSea />
        <PosterBacklot />
        <RecordStoreInteriorScene />
        <RecordStoreBuilding />
        <PosterRoad />
        <PosterEffects />

        <RecordStoreDialog rootId={rootId} choices={choices} client:load />
      </div>
    </div>
  </div>

  <RecordStoreScrollController rootId={rootId} client:load />
</div>
