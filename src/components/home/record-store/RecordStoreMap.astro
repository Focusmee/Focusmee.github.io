---
import { getCollectionTransitionNames } from "../../../utils/transitions";
import { getUiText } from "../../../i18n/ui";
import { withBase } from "../../../utils/links";
import { homeHotspots } from "../homeHotspots";
---

<div class="record-store-map" id="store-map">
  <div class="record-store-map__heading">
    <span class="record-store-eyebrow" data-i18n="store.map.eyebrow">
      {getUiText("store.map.eyebrow")}
    </span>
    <h2 data-i18n="store.map.title">{getUiText("store.map.title")}</h2>
    <p data-i18n="store.map.lede">
      {getUiText("store.map.lede")}
    </p>
  </div>

  <div class="record-store-map__grid">
    {
      homeHotspots.map((item) => {
        const transitionNames = getCollectionTransitionNames(item.id);

        return (
          <a class={`store-object store-object--${item.id}`} href={withBase(item.href)}>
            <span
              class="store-object__kicker"
              transition:name={transitionNames.eyebrow}
              data-i18n={`collections.${item.id}.object`}
            >
              {getUiText(`collections.${item.id}.object`)}
            </span>
            <strong
              transition:name={transitionNames.title}
              data-i18n={`collections.${item.id}.title`}
            >
              {getUiText(`collections.${item.id}.title`)}
            </strong>
            <p data-i18n={`collections.${item.id}.description`}>
              {getUiText(`collections.${item.id}.description`)}
            </p>
          </a>
        );
      })
    }
  </div>
</div>
