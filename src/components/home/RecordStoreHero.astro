---
import Button from "../ui/Button.astro";
import { getUiText } from "../../i18n/ui";
import { withBase } from "../../utils/links";
import { pickRandomItem } from "../../utils/random";
import { getPublishedLogs } from "../../utils/posts";
import { homeDialogChoices } from "./homeDialogChoices";
import RecordStoreMap from "./record-store/RecordStoreMap.astro";
import RecordStorePoster from "./record-store/poster/RecordStorePoster.astro";
import RetroComputerEntrance from "./retro-computer/RetroComputerEntrance";
import "../../styles/home-retro-computer.css";
import "../../styles/home-record-store.css";
import "../../styles/home-record-store-interior.css";

const rootId = "record-store-hero";
const posts = await getPublishedLogs();
const randomPost = pickRandomItem(posts);
const dialogChoices = homeDialogChoices.map((choice) => ({
  ...choice,
  href: withBase(choice.href)
}));
---

<section
  id={rootId}
  class="record-store-hero"
  data-entry-state="intro"
  data-scroll-ready="false"
  data-scroll-phase="outside"
  aria-labelledby="record-store-title"
>
  <RetroComputerEntrance rootId={rootId} client:only="react" />
  <RecordStorePoster rootId={rootId} choices={dialogChoices} />

  <div class="record-store-hero__intro">
    <span class="record-store-eyebrow" data-i18n="home.hero.eyebrow">
      {getUiText("home.hero.eyebrow")}
    </span>
    <p class="record-store-copy" data-i18n="home.hero.copy">
      {getUiText("home.hero.copy")}
    </p>

    {
      randomPost && (
        <div class="record-store-actions">
          <Button href={withBase(`/logs/${randomPost.id}`)} variant="secondary">
            <span data-i18n="home.hero.random">{getUiText("home.hero.random")}</span>
          </Button>
        </div>
      )
    }
  </div>

  <RecordStoreMap />
</section>
