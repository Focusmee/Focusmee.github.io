---
import { ClientRouter, fade } from "astro:transitions";
import "../../styles/global.css";
import SiteNav from "../ui/SiteNav.astro";
import SiteFooter from "../ui/SiteFooter.astro";
import { siteConfig } from "../../data/site";
import {
  DEFAULT_LANGUAGE,
  LANGUAGE_STORAGE_KEY,
  uiTranslations
} from "../../i18n/ui";
import { withBase } from "../../utils/links";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description
} = Astro.props as Props;

const pageTitle =
  title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const rssHref = withBase("/rss.xml");
---

<!doctype html>
<html lang={siteConfig.locale} data-language={DEFAULT_LANGUAGE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={rssHref}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="site-body">
    <SiteNav />
    <main
      id="content"
      class="site-main"
      transition:animate={fade({ duration: "180ms" })}
    >
      <slot />
    </main>
    <SiteFooter />
    <script
      is:inline
      define:vars={{
        defaultLanguage: DEFAULT_LANGUAGE,
        storageKey: LANGUAGE_STORAGE_KEY,
        translations: uiTranslations
      }}
    >
      (() => {
        const languages = Object.keys(translations);
        let currentLanguage = defaultLanguage;

        const normalizeLanguage = (value) =>
          languages.includes(value) ? value : "";

        const getInitialLanguage = () => {
          try {
            const stored = normalizeLanguage(localStorage.getItem(storageKey) || "");

            if (stored) {
              return stored;
            }
          } catch {
            // Ignore storage access failures and keep the static default language.
          }

          return defaultLanguage;
        };

        const getText = (key, language) =>
          translations[language]?.[key] || translations.en?.[key] || key;

        const formatText = (text, element, language) =>
          text.replace(/\{([a-zA-Z0-9_-]+)\}/g, (_, name) => {
            const keyedValue = element.getAttribute(`data-i18n-var-${name}-key`);

            if (keyedValue) {
              return getText(keyedValue, language);
            }

            return element.getAttribute(`data-i18n-var-${name}`) || "";
          });

        const collect = (scope, selector) => {
          const root = scope || document;
          const items = [];

          if (root instanceof Element && root.matches(selector)) {
            items.push(root);
          }

          if ("querySelectorAll" in root) {
            items.push(...root.querySelectorAll(selector));
          }

          return items;
        };

        const formatDate = (element, language) => {
          const rawDate = element.getAttribute("datetime");

          if (!rawDate) {
            return;
          }

          const date = new Date(rawDate);

          if (Number.isNaN(date.valueOf())) {
            return;
          }

          const locale = language === "zh" ? "zh-CN" : "en";
          element.textContent = new Intl.DateTimeFormat(locale, {
            year: "numeric",
            month: "long",
            day: "numeric"
          }).format(date);
        };

        const applyText = (scope, language) => {
          collect(scope, "[data-i18n]").forEach((element) => {
            const key = element.getAttribute("data-i18n");
            const text = key ? formatText(getText(key, language), element, language) : "";

            if (element.textContent !== text) {
              element.textContent = text;
            }
          });

          collect(scope, "[data-i18n-aria-label]").forEach((element) => {
            const key = element.getAttribute("data-i18n-aria-label");

            if (key) {
              element.setAttribute(
                "aria-label",
                formatText(getText(key, language), element, language)
              );
            }
          });

          collect(scope, "[data-i18n-title]").forEach((element) => {
            const key = element.getAttribute("data-i18n-title");

            if (key) {
              element.setAttribute(
                "title",
                formatText(getText(key, language), element, language)
              );
            }
          });

          collect(scope, "[data-i18n-placeholder]").forEach((element) => {
            const key = element.getAttribute("data-i18n-placeholder");

            if (key) {
              element.setAttribute(
                "placeholder",
                formatText(getText(key, language), element, language)
              );
            }
          });

          collect(scope, "[data-i18n-date]").forEach((element) => {
            formatDate(element, language);
          });
        };

        const syncControls = (language) => {
          document.querySelectorAll("[data-language-toggle]").forEach((button) => {
            const active = button.getAttribute("data-language-toggle") === language;
            button.classList.toggle("is-active", active);
            button.setAttribute("aria-pressed", String(active));
          });
        };

        const applyLanguage = (language, options = {}) => {
          const nextLanguage = normalizeLanguage(language) || defaultLanguage;
          currentLanguage = nextLanguage;

          document.documentElement.lang = nextLanguage === "zh" ? "zh-CN" : "en";
          document.documentElement.dataset.language = nextLanguage;
          applyText(document, nextLanguage);
          syncControls(nextLanguage);

          if (!options.skipStorage) {
            try {
              localStorage.setItem(storageKey, nextLanguage);
            } catch {
              // The visible language state still works if storage is unavailable.
            }
          }

          document.dispatchEvent(
            new CustomEvent("blooming-language-change", {
              detail: { language: nextLanguage }
            })
          );
        };

        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const button = target?.closest("[data-language-toggle]");

          if (!button) {
            return;
          }

          applyLanguage(button.getAttribute("data-language-toggle"));
        });

        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === "attributes" && mutation.target instanceof Element) {
              applyText(mutation.target, currentLanguage);
            }

            if (
              mutation.type === "characterData" &&
              mutation.target.parentElement instanceof Element
            ) {
              applyText(mutation.target.parentElement, currentLanguage);
            }

            mutation.addedNodes.forEach((node) => {
              if (node instanceof Element || node instanceof DocumentFragment) {
                applyText(node, currentLanguage);
              }
            });
          });
        });

        observer.observe(document.documentElement, {
          attributes: true,
          childList: true,
          characterData: true,
          attributeFilter: [
            "data-i18n",
            "data-i18n-aria-label",
            "data-i18n-title",
            "data-i18n-placeholder",
            "datetime"
          ],
          subtree: true
        });

        document.addEventListener("astro:page-load", () => {
          applyLanguage(currentLanguage, { skipStorage: true });
        });

        window.BloomingI18n = {
          setLanguage: applyLanguage,
          getLanguage: () => currentLanguage
        };

        applyLanguage(getInitialLanguage(), { skipStorage: true });
      })();
    </script>
  </body>
</html>
