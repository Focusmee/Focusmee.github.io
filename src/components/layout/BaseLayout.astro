---
import "../../styles/global.css";
import SiteNav from "../ui/SiteNav.astro";
import SiteFooter from "../ui/SiteFooter.astro";
import { siteConfig } from "../../data/site";
import { withBase } from "../../utils/links";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  ogImage,
  type = "website"
} = Astro.props as Props;

const pageTitle =
  title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const socialImage =
  ogImage && Astro.site
    ? new URL(ogImage.startsWith("/") ? withBase(ogImage) : ogImage, Astro.site).toString()
    : ogImage;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3eee5" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={withBase("/rss.xml")}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <slot name="head" />
  </head>
  <body>
    <SiteNav />
    <main id="content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
