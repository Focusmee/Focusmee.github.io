---
import BaseLayout from "./BaseLayout.astro";
import GiscusComments from "../comments/GiscusComments.astro";
import Tag from "../ui/Tag.astro";
import { formatDate, getReadingMinutes } from "../../utils/format";
import { getCollectionMeta } from "../../data/collections";
import { getUiText } from "../../i18n/ui";
import { withBase } from "../../utils/links";
import type { LogEntry } from "../../utils/posts";

interface Props {
  entry: LogEntry;
  previous?: LogEntry | null;
  next?: LogEntry | null;
}

const { entry, previous = null, next = null } = Astro.props as Props;

const collection = getCollectionMeta(entry.data.category);
const readingMinutes = getReadingMinutes(entry.body ?? "");
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="post-shell">
    <a class="eyebrow-link" href={withBase("/logs")} data-i18n="post.back">
      {getUiText("post.back")}
    </a>

    <header
      class="post-hero"
      style={`--accent: var(--${collection?.color ?? "sunflower"});`}
    >
      <div class="tag-row">
        <Tag
          label={collection?.title ?? entry.data.category}
          i18nKey={collection ? `collections.${collection.id}.title` : undefined}
          accent
        />
        <time class="tag" datetime={entry.data.pubDate.toISOString()} data-i18n-date>
          {formatDate(entry.data.pubDate)}
        </time>
        <span
          class="tag"
          data-i18n="post.minRead"
          data-i18n-var-minutes={String(readingMinutes)}
        >
          {readingMinutes} 分钟阅读
        </span>
      </div>

      <h1>{entry.data.title}</h1>
      <p class="post-summary">{entry.data.description}</p>

      {entry.data.tags.length > 0 && (
        <div class="tag-row" style="margin-top: 1rem;">
          {entry.data.tags.map((tag) => <Tag label={tag} />)}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <GiscusComments
      title={getUiText("post.discussTitle")}
      titleKey="post.discussTitle"
      description={getUiText("post.discussDescription")}
      descriptionKey="post.discussDescription"
    />

    <nav
      class="post-pagination"
      aria-label={getUiText("post.navigation")}
      data-i18n-aria-label="post.navigation"
    >
      {next ? (
        <a class="pagination-card" href={withBase(`/logs/${next.id}`)}>
          <div class="detail-kicker" data-i18n="post.newer">
            {getUiText("post.newer")}
          </div>
          <strong>{next.data.title}</strong>
        </a>
      ) : (
        <div class="pagination-card">
          <div class="detail-kicker" data-i18n="post.newer">
            {getUiText("post.newer")}
          </div>
          <strong data-i18n="post.noNewer">{getUiText("post.noNewer")}</strong>
        </div>
      )}

      {previous ? (
        <a class="pagination-card" href={withBase(`/logs/${previous.id}`)}>
          <div class="detail-kicker" data-i18n="post.older">
            {getUiText("post.older")}
          </div>
          <strong>{previous.data.title}</strong>
        </a>
      ) : (
        <div class="pagination-card">
          <div class="detail-kicker" data-i18n="post.older">
            {getUiText("post.older")}
          </div>
          <strong data-i18n="post.noOlder">{getUiText("post.noOlder")}</strong>
        </div>
      )}
    </nav>
  </article>
</BaseLayout>
