---
import BaseLayout from "./BaseLayout.astro";
import GiscusComments from "../comments/GiscusComments.astro";
import MediaFrame from "../media/MediaFrame.astro";
import Tag from "../ui/Tag.astro";
import { formatDate, getReadingMinutes } from "../../utils/format";
import { withBase } from "../../utils/links";
import type { LogEntry } from "../../utils/posts";

interface Props {
  entry: LogEntry;
  previous?: LogEntry | null;
  next?: LogEntry | null;
}

const { entry, previous = null, next = null } = Astro.props as Props;
const readingMinutes = getReadingMinutes(entry.body ?? "");
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.cover}
  type="article"
>
  <article class="post-shell">
    <a class="back-link" href={withBase("/logs")}>← 返回博客</a>

    <header class="post-header">
      <div class="post-header__meta">
        <time datetime={entry.data.pubDate.toISOString()}>
          {formatDate(entry.data.pubDate)}
        </time>
        <span aria-hidden="true">/</span>
        <span>{readingMinutes} 分钟阅读</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      {entry.data.tags.length > 0 && (
        <div class="tag-row" aria-label="标签">
          {entry.data.tags.map((tag) => <Tag label={tag} />)}
        </div>
      )}
    </header>

    {entry.data.cover && (
      <div class="post-cover">
        <MediaFrame
          src={entry.data.cover}
          alt={entry.data.coverAlt || entry.data.title}
          shape={entry.data.coverShape}
          href={entry.data.cover}
          eager
        />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <GiscusComments title="讨论这篇文章" />

    <nav class="post-pagination" aria-label="文章导航">
      {next ? (
        <a href={withBase(`/logs/${next.id}`)}>
          <span>更新一篇</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : (
        <div aria-hidden="true"></div>
      )}

      {previous ? (
        <a href={withBase(`/logs/${previous.id}`)}>
          <span>更早一篇</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : (
        <div aria-hidden="true"></div>
      )}
    </nav>
  </article>
</BaseLayout>
