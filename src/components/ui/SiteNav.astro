---
import { navigation } from "../../data/navigation";
import { siteConfig } from "../../data/site";
import { stripBase, withBase } from "../../utils/links";

const currentPath = stripBase(Astro.url.pathname);
---

<a class="skip-link" href="#content">跳到正文</a>

<header class="site-nav">
  <div class="nav-inner">
    <a class="brand" href={withBase("/")} aria-label={`${siteConfig.name} 首页`}>
      <span class="brand-mark">{siteConfig.name}</span>
      <span class="brand-edition" aria-hidden="true">/ 01</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {
        navigation.map((item) => {
          const active =
            item.href === "/"
              ? currentPath === "/"
              : currentPath === item.href ||
                currentPath.startsWith(`${item.href}/`);

          return (
            <a
              class:list={["nav-link", active && "is-active"]}
              href={withBase(item.href)}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
