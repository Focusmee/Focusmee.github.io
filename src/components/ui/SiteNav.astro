---
import { navigation } from "../../data/navigation";
import { siteConfig } from "../../data/site";
import { stripBase, withBase } from "../../utils/links";

const currentPath = stripBase(Astro.url.pathname);
---

<a class="skip-link" href="#content">Skip to content</a>

<header class="site-nav">
  <div class="nav-inner">
    <a class="brand" href={withBase("/")}>
      <span class="brand-mark">{siteConfig.name}</span>
      <span class="brand-note">white vinyl house by the sea</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        navigation.map((item) => {
          const active =
            item.href === "/"
              ? currentPath === "/"
              : currentPath === item.href || currentPath.startsWith(`${item.href}/`);

          return (
            <a
              class:list={["nav-link", active && "is-active"]}
              href={withBase(item.href)}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
