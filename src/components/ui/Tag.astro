---
interface Props {
  label: string;
  href?: string;
  accent?: boolean;
}

const { label, href, accent = false } = Astro.props as Props;
const className = accent ? "tag tag--accent" : "tag";
---

{
  href ? (
    <a class={className} href={href}>
      {label}
    </a>
  ) : (
    <span class={className}>{label}</span>
  )
}
