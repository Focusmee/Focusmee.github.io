---
import BaseLayout from "../components/layout/BaseLayout.astro";
import MovieCard from "../components/media/MovieCard.astro";
import PhotoCard from "../components/media/PhotoCard.astro";
import RecentPosts from "../components/posts/RecentPosts.astro";
import { siteConfig } from "../data/site";
import { withBase } from "../utils/links";
import { getPublishedMovies, getPublishedPhotos } from "../utils/media";
import { getRecentLogs } from "../utils/posts";

const [recentPosts, movies, photos] = await Promise.all([
  getRecentLogs(5),
  getPublishedMovies(4),
  getPublishedPhotos(6)
]);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="home-intro">
    <div class="home-intro__edition" aria-hidden="true">
      <span>个人记录</span>
      <span>2026 — 至今</span>
    </div>
    <div class="home-intro__copy">
      <p class="home-intro__name">Focusmee</p>
      <h1>把写过的、看过的、拍下的，放在一起。</h1>
      <p>
        这里收录我的技术文章、电影短笺和日常影像。没有复杂入口，
        从最近更新开始就好。
      </p>
      <div class="home-intro__actions">
        <a class="text-link" href={withBase("/logs")}>阅读博客 <span>↗</span></a>
        <a class="text-link text-link--muted" href={withBase("/about")}>
          关于我 <span>↗</span>
        </a>
      </div>
    </div>
    <div class="home-intro__mark" aria-hidden="true">F.</div>
  </section>

  <RecentPosts
    posts={recentPosts}
    label="01 / Writing"
    title="最近更新"
    description="技术、系统与日常思考，按发布时间排列。"
  />

  {
    movies.length > 0 && (
      <section class="content-section">
        <header class="section-heading section-heading--row">
          <div>
            <span class="section-label">02 / Cinema</span>
            <h2>喜欢的电影</h2>
          </div>
          <a class="section-link" href={withBase("/movies")}>查看全部 ↗</a>
        </header>
        <div class="movie-grid">
          {movies.map((entry, index) => (
            <MovieCard entry={entry} eager={index < 2} />
          ))}
        </div>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section class="content-section">
        <header class="section-heading section-heading--row">
          <div>
            <span class="section-label">03 / Photographs</span>
            <h2>最近的图片</h2>
          </div>
          <a class="section-link" href={withBase("/photos")}>查看全部 ↗</a>
        </header>
        <div class="photo-grid">
          {photos.map((entry, index) => (
            <PhotoCard entry={entry} eager={index < 2} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
