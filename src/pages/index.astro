---
import BaseLayout from "../components/layout/BaseLayout.astro";
import CollectionGrid from "../components/collections/CollectionGrid.astro";
import RecentPosts from "../components/posts/RecentPosts.astro";
import RecordStoreHero from "../components/home/RecordStoreHero.astro";
import { siteConfig } from "../data/site";
import { getUiText } from "../i18n/ui";
import { getFeaturedLogs, getPublishedLogs } from "../utils/posts";

const featuredPosts = await getFeaturedLogs(3);
const featuredIds = new Set(featuredPosts.map((entry) => entry.id));
const recentPosts = (await getPublishedLogs())
  .filter((entry) => !featuredIds.has(entry.id))
  .slice(0, 3);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <RecordStoreHero />

  <RecentPosts
    posts={featuredPosts}
    eyebrowKey="home.featured.eyebrow"
    titleKey="home.featured.title"
    ledeKey="home.featured.lede"
  />

  <RecentPosts
    posts={recentPosts}
    eyebrowKey="home.recent.eyebrow"
    titleKey="home.recent.title"
    ledeKey="home.recent.lede"
  />

  <section class="section-shell">
    <div class="section-heading">
      <span class="eyebrow" data-i18n="home.collections.eyebrow">
        {getUiText("home.collections.eyebrow")}
      </span>
      <h2 class="headline" data-i18n="home.collections.title">
        {getUiText("home.collections.title")}
      </h2>
      <p class="lede" data-i18n="home.collections.lede">
        {getUiText("home.collections.lede")}
      </p>
    </div>

    <CollectionGrid />
  </section>

  <section class="section-shell split-grid">
    <div class="intro-slab">
      <div class="section-heading">
        <span class="eyebrow" data-i18n="home.about.eyebrow">
          {getUiText("home.about.eyebrow")}
        </span>
        <h2 class="headline" data-i18n="home.about.title">
          {getUiText("home.about.title")}
        </h2>
      </div>
      <p class="lede" data-i18n="home.about.lede">
        {getUiText("home.about.lede")}
      </p>
    </div>

    <div class="detail-list">
      <div class="detail-item">
        <div class="detail-kicker" data-i18n="home.about.readyKicker">
          {getUiText("home.about.readyKicker")}
        </div>
        <strong data-i18n="home.about.ready">{getUiText("home.about.ready")}</strong>
      </div>
      <div class="detail-item">
        <div class="detail-kicker" data-i18n="home.about.nextKicker">
          {getUiText("home.about.nextKicker")}
        </div>
        <strong data-i18n="home.about.next">{getUiText("home.about.next")}</strong>
      </div>
    </div>
  </section>
</BaseLayout>
