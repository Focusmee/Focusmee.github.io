---
import BaseLayout from "../components/layout/BaseLayout.astro";
import GiscusComments from "../components/comments/GiscusComments.astro";
---

<BaseLayout title="Guestbook" description="整站留言板与互动页。">
  <section class="section-shell">
    <div class="section-heading">
      <span class="eyebrow">Guestbook</span>
      <h1 class="headline">This drawer is waiting for voices.</h1>
      <p class="lede">
        这里现在已经接好 Giscus。只要把仓库参数填完整，它就会成为整站留言板，也可以和文章页评论共用同一套 Discussions。
      </p>
    </div>

    <GiscusComments
      title="Leave a note"
      description="留言会写进 GitHub Discussions，适合作为 Guestbook，也方便后续归档。"
      showSetupHint={true}
    />
  </section>
</BaseLayout>
