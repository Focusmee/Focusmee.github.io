---
import BaseLayout from "../components/layout/BaseLayout.astro";
import GiscusComments from "../components/comments/GiscusComments.astro";
import { getUiText } from "../i18n/ui";
---

<BaseLayout title="Guestbook" description="整站留言板与互动页。">
  <section class="section-shell">
    <div class="section-heading">
      <span class="eyebrow" data-i18n="guestbook.eyebrow">
        {getUiText("guestbook.eyebrow")}
      </span>
      <h1 class="headline" data-i18n="guestbook.title">
        {getUiText("guestbook.title")}
      </h1>
      <p class="lede" data-i18n="guestbook.lede">
        {getUiText("guestbook.lede")}
      </p>
    </div>

    <GiscusComments
      title={getUiText("guestbook.commentsTitle")}
      titleKey="guestbook.commentsTitle"
      description={getUiText("guestbook.commentsDescription")}
      descriptionKey="guestbook.commentsDescription"
      showSetupHint={true}
    />
  </section>
</BaseLayout>
