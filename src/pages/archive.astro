---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { formatDate } from "../utils/format";
import { withBase } from "../utils/links";
import { groupPostsByYear, getPublishedLogs } from "../utils/posts";

const posts = await getPublishedLogs();
const grouped = groupPostsByYear(posts);
const years = Object.keys(grouped).sort(
  (left, right) => Number(right) - Number(left)
);
---

<BaseLayout title="归档" description="按年份浏览 Focusmee 的全部公开文章。">
  <header class="page-header">
    <span class="section-label">Archive / {posts.length} posts</span>
    <h1>文章归档</h1>
    <p>按发布日期整理的完整时间线。</p>
  </header>

  <div class="archive">
    {
      years.map((year) => (
        <section class="archive-group">
          <h2>{year}</h2>
          <div class="archive-list">
            {grouped[year]?.map((entry) => (
              <article class="archive-item">
                <time datetime={entry.data.pubDate.toISOString()}>
                  {formatDate(entry.data.pubDate)}
                </time>
                <h3>
                  <a href={withBase(`/logs/${entry.id}`)}>{entry.data.title}</a>
                </h3>
                <span aria-hidden="true">↗</span>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
