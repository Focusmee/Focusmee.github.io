---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { siteConfig } from "../data/site";
import { getUiText } from "../i18n/ui";

const technicalKeywords = [
  "Java",
  "Spring Boot",
  "MySQL",
  "Redis",
  "Docker",
  "Git",
  "Workflow Execution",
  "SSE",
  "Concurrent Systems",
  "AI-assisted Development"
];
const selectedHonors = [
  "about.honor1",
  "about.honor2",
  "about.honor3",
  "about.honor4"
];
---

<BaseLayout
  title="About"
  description="关于我、我正在研究的方向，以及为什么会把 Agent、移动安全、系统设计和日常观察一起放进这个站里。"
>
  <section class="section-shell split-grid">
    <div class="intro-slab">
      <div class="section-heading">
        <span class="eyebrow" data-i18n="about.eyebrow">
          {getUiText("about.eyebrow")}
        </span>
        <h1 class="headline" data-i18n="about.title">
          {getUiText("about.title")}
        </h1>
      </div>
      <p class="lede" data-i18n="about.p1">
        {getUiText("about.p1")}
      </p>
      <p class="lede" data-i18n="about.p2">
        {getUiText("about.p2")}
      </p>
      <p class="lede" data-i18n="about.p3">
        {getUiText("about.p3")}
      </p>
      <p class="lede" data-i18n="about.p4">
        {getUiText("about.p4")}
      </p>
      <p class="lede" data-i18n="about.p5">
        {getUiText("about.p5")}
      </p>
      <p class="lede" data-i18n="about.p6">
        {getUiText("about.p6")}
      </p>
    </div>

    <div class="detail-list">
      <div class="detail-item">
        <div class="detail-kicker" data-i18n="about.currentFocus">
          {getUiText("about.currentFocus")}
        </div>
        <strong data-i18n="about.currentFocusValue">
          {getUiText("about.currentFocusValue")}
        </strong>
        <p class="note-line" data-i18n="about.focusLine">
          {getUiText("about.focusLine")}
        </p>
      </div>

      <div class="detail-item">
        <div class="detail-kicker" data-i18n="about.technicalKeywords">
          {getUiText("about.technicalKeywords")}
        </div>
        <div class="tag-row">
          {technicalKeywords.map((item) => <span class="tag">{item}</span>)}
        </div>
      </div>

      <div class="detail-item">
        <div class="detail-kicker" data-i18n="about.selectedHonors">
          {getUiText("about.selectedHonors")}
        </div>
        <ul class="profile-list">
          {selectedHonors.map((item) => <li data-i18n={item}>{getUiText(item)}</li>)}
        </ul>
      </div>

      <div class="detail-item">
        <div class="detail-kicker" data-i18n="about.siteHolds">
          {getUiText("about.siteHolds")}
        </div>
        <strong>{siteConfig.name}</strong>
        <p class="note-line" data-i18n="site.tagline">{getUiText("site.tagline")}</p>
        <p class="note-line" data-i18n="about.siteHoldsLine">
          {getUiText("about.siteHoldsLine")}
        </p>
      </div>

      <div class="detail-item">
        <div class="detail-kicker" data-i18n="about.contact">
          {getUiText("about.contact")}
        </div>
        <p class="note-line">
          <span data-i18n="about.github">{getUiText("about.github")}</span>: {siteConfig.social.github}
        </p>
        <p class="note-line">
          <span data-i18n="about.email">{getUiText("about.email")}</span>: {siteConfig.email}
        </p>
        <p class="note-line">
          <span data-i18n="about.phone">{getUiText("about.phone")}</span>: {siteConfig.phone}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .profile-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    line-height: 1.7;
  }
</style>
