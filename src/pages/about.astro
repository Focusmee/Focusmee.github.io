---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { siteConfig } from "../data/site";

const technicalKeywords = [
  "Java",
  "Spring Boot",
  "MySQL",
  "Redis",
  "Docker",
  "Workflow Execution",
  "SSE",
  "Concurrent Systems",
  "AI-assisted Development"
];

const selectedHonors = [
  "第20届全国大学生信息安全与对抗技术竞赛决赛 BCI 脑机接口应用赛道二等奖（国家级）",
  "第20届全国大学生信息安全与对抗技术竞赛决赛 自动驾驶任务赛道三等奖（国家级）",
  "第七届湖南省大学生物联网应用创新设计竞赛二等奖",
  "湘潭市优秀毕业生，以及多项奖学金与学生骨干荣誉"
];
---

<BaseLayout
  title="关于"
  description="关于 Focusmee、正在研究的方向和这个个人网站。"
>
  <header class="page-header page-header--about">
    <span class="section-label">About</span>
    <h1>我在系统、Agent 和日常观察之间持续学习与构建。</h1>
  </header>

  <div class="about-layout">
    <div class="about-copy prose">
      <p>
        我目前在广州大学攻读硕士学位，持续学习和研究 Agent 与移动安全。
        本科阶段主要围绕 Java 后端开发、系统设计和工程实践积累经验。
      </p>
      <p>
        我参与过物联网通信系统、脑机接口应用、自动驾驶控制、模拟经营游戏
        和 AI Agent 工作流编排平台等项目。相比功能堆叠，我更在意一个系统
        能否稳定执行，以及人与系统能否自然协作。
      </p>
      <p>
        Focusmee 是我的长期记录空间。这里既有关于 Agent、工作流、并发与
        上下文传递的文章，也会留下电影和日常图片。
      </p>
    </div>

    <aside class="about-facts">
      <section>
        <span class="section-label">Current</span>
        <h2>广州大学硕士在读</h2>
        <p>研究方向：Agent / 移动安全</p>
      </section>

      <section>
        <span class="section-label">Stack</span>
        <div class="tag-row">
          {technicalKeywords.map((item) => <span class="tag">{item}</span>)}
        </div>
      </section>

      <section>
        <span class="section-label">Selected honors</span>
        <ul>
          {selectedHonors.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section>
        <span class="section-label">Contact</span>
        <dl class="contact-list">
          <div>
            <dt>GitHub</dt>
            <dd>
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                Focusmee
              </a>
            </dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a></dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>
</BaseLayout>
