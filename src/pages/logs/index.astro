---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PostList from "../../components/posts/PostList.astro";
import Tag from "../../components/ui/Tag.astro";
import { collections } from "../../data/collections";
import { getUiText } from "../../i18n/ui";
import { withBase } from "../../utils/links";
import { getPublishedLogs } from "../../utils/posts";

const posts = await getPublishedLogs();
---

<BaseLayout
  title="Logs"
  description="Browse every published log across shelves and timeline."
>
  <section class="section-shell">
    <div class="section-heading">
      <span class="eyebrow" data-i18n="logs.eyebrow">
        {getUiText("logs.eyebrow")}
      </span>
      <h1 class="headline" data-i18n="logs.title">{getUiText("logs.title")}</h1>
      <p class="lede" data-i18n="logs.lede">
        {getUiText("logs.lede")}
      </p>
    </div>

    <div class="tag-row" style="margin-bottom: 1.5rem;">
      {collections.map((collection) => (
        <Tag
          label={collection.title}
          i18nKey={`collections.${collection.id}.title`}
          href={withBase(collection.href)}
          accent
        />
      ))}
      <Tag
        label={getUiText("logs.archiveTag")}
        i18nKey="logs.archiveTag"
        href={withBase("/archive")}
        accent
      />
    </div>

    <PostList posts={posts} />
  </section>
</BaseLayout>
