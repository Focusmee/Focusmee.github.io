---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PostList from "../../components/posts/PostList.astro";
import Tag from "../../components/ui/Tag.astro";
import { collections } from "../../data/collections";
import { withBase } from "../../utils/links";
import { getPublishedLogs } from "../../utils/posts";

const posts = await getPublishedLogs();
---

<BaseLayout
  title="Logs"
  description="Browse every published log across shelves and timeline."
>
  <section class="section-shell">
    <div class="section-heading">
      <span class="eyebrow">Logs</span>
      <h1 class="headline">All notes on the shelf.</h1>
      <p class="lede">
        This page stays clean for reading and scanning. Use the six shelves for
        editorial groupings, or open Archive for the full house-wide timeline.
      </p>
    </div>

    <div class="tag-row" style="margin-bottom: 1.5rem;">
      {collections.map((collection) => (
        <Tag label={collection.title} href={withBase(collection.href)} accent />
      ))}
      <Tag label="Archive timeline" href={withBase("/archive")} accent />
    </div>

    <PostList posts={posts} />
  </section>
</BaseLayout>
