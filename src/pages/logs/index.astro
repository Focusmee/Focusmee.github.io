---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PostList from "../../components/posts/PostList.astro";
import { getPublishedLogs } from "../../utils/posts";

const posts = await getPublishedLogs();
---

<BaseLayout title="博客" description="Focusmee 发布的全部文章。">
  <header class="page-header">
    <span class="section-label">Index / {String(posts.length).padStart(2, "0")} posts</span>
    <h1>文章索引</h1>
    <div class="page-header__intro">
      <span aria-hidden="true">↳</span>
      <p>记录技术、系统设计和日常思考。最新发布的文章排在最前面。</p>
    </div>
  </header>

  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <div class="empty-state">
        <strong>还没有公开文章</strong>
        <p>将 Markdown 文件放入内容目录后，文章会自动出现在这里。</p>
      </div>
    )
  }
</BaseLayout>
