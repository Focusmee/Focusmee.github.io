---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { manualProjects } from "../data/projects";
import { formatDate } from "../utils/format";
import { getGitHubProjects } from "../utils/github";

const githubProjects = await getGitHubProjects();
---

<BaseLayout
  title="项目"
  description="Focusmee 的公开项目、系统实践与代表作品。"
>
  <header class="page-header">
    <span class="section-label">Projects</span>
    <h1>项目</h1>
    <p>一些公开构建、系统实践，以及比仓库链接更重要的工作说明。</p>
  </header>

  <section class="project-section">
    <header class="section-heading section-heading--row">
      <div>
        <span class="section-label">Open source</span>
        <h2>GitHub 项目</h2>
      </div>
      <p>构建时读取公开仓库信息；网络不可用时使用本地资料。</p>
    </header>

    <div class="project-grid">
      {
        githubProjects.map((project) => (
          <article class="project-card">
            <div class="project-card__meta">
              <span>{project.status}</span>
              {project.language && <span>{project.language}</span>}
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tag-row">
              {project.stack.split(",").map((item) => (
                <span class="tag">{item.trim()}</span>
              ))}
            </div>
            <div class="project-card__details">
              {project.stargazersCount > 0 && <span>★ {project.stargazersCount}</span>}
              {project.updatedAt && (
                <time datetime={project.updatedAt}>
                  更新于 {formatDate(new Date(project.updatedAt))}
                </time>
              )}
            </div>
            <div class="project-card__links">
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                查看仓库 ↗
              </a>
              {project.homepage && (
                <a
                  href={project.homepage}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  打开站点 ↗
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="project-section">
    <header class="section-heading section-heading--row">
      <div>
        <span class="section-label">Selected work</span>
        <h2>代表项目</h2>
      </div>
      <p>没有独立公开仓库，但值得保留的项目经历。</p>
    </header>

    <div class="project-list">
      {
        manualProjects.map((project) => (
          <article class="project-card project-card--wide">
            <div class="project-card__meta">
              <span>{project.status}</span>
              <span>{project.period}</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <strong>{project.stack}</strong>
            <ul>
              {project.highlights.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
