---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { manualProjects } from "../data/projects";
import { getUiText } from "../i18n/ui";
import { getGitHubProjects } from "../utils/github";
import { formatDate } from "../utils/format";

const githubProjects = await getGitHubProjects();
---

<BaseLayout
  title="Projects"
  description="公开项目、正在关心的系统、以及比仓库链接更重要的工作说明。"
>
  <section class="section-shell">
    <div class="section-heading">
      <span class="eyebrow" data-i18n="projects.eyebrow">
        {getUiText("projects.eyebrow")}
      </span>
      <h1 class="headline" data-i18n="projects.title">
        {getUiText("projects.title")}
      </h1>
      <p class="lede" data-i18n="projects.lede">
        {getUiText("projects.lede")}
      </p>
    </div>
  </section>

  <section class="section-shell split-grid">
    <div class="intro-slab">
      <div class="section-heading">
        <span class="eyebrow" data-i18n="projects.github.eyebrow">
          {getUiText("projects.github.eyebrow")}
        </span>
        <h2 class="headline" data-i18n="projects.github.title">
          {getUiText("projects.github.title")}
        </h2>
      </div>
      <p class="lede" data-i18n="projects.github.lede">
        {getUiText("projects.github.lede")}
      </p>
    </div>

    <div class="detail-list">
      <div class="detail-item">
        <div class="detail-kicker" data-i18n="projects.github.syncKicker">
          {getUiText("projects.github.syncKicker")}
        </div>
        <strong data-i18n="projects.github.syncText">
          {getUiText("projects.github.syncText")}
        </strong>
      </div>
      <div class="detail-item">
        <div class="detail-kicker" data-i18n="projects.github.manualKicker">
          {getUiText("projects.github.manualKicker")}
        </div>
        <strong data-i18n="projects.github.manualText">
          {getUiText("projects.github.manualText")}
        </strong>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="project-grid">
      {
        githubProjects.map((project) => (
          <article class="post-card project-card" style={`--accent: var(--${project.accent});`}>
            <div class="meta-row">
              <span class="tag tag--accent" data-i18n={`${project.i18nKey}.status`}>
                {getUiText(`${project.i18nKey}.status`)}
              </span>
              <span>{project.stack}</span>
            </div>
            <h2 class="card-title" data-i18n={`${project.i18nKey}.title`}>
              {getUiText(`${project.i18nKey}.title`)}
            </h2>
            <p class="card-copy" data-i18n={`${project.i18nKey}.description`}>
              {getUiText(`${project.i18nKey}.description`)}
            </p>
            <div class="meta-row">
              {project.language && (
                <span
                  data-i18n="projects.primaryLanguage"
                  data-i18n-var-language={project.language}
                >
                  {getUiText("projects.primaryLanguage").replace(
                    "{language}",
                    project.language
                  )}
                </span>
              )}
              {project.stargazersCount > 0 && (
                <span
                  data-i18n="projects.stars"
                  data-i18n-var-count={String(project.stargazersCount)}
                >
                  {getUiText("projects.stars").replace(
                    "{count}",
                    String(project.stargazersCount)
                  )}
                </span>
              )}
              {project.updatedAt && (
                <span>
                  <span data-i18n="projects.updatedPrefix">
                    {getUiText("projects.updatedPrefix")}
                  </span>{" "}
                  <time datetime={project.updatedAt} data-i18n-date>
                    {formatDate(new Date(project.updatedAt))}
                  </time>
                </span>
              )}
            </div>
            <div class="project-links">
              <a class="button button-secondary" href={project.url} target="_blank" rel="noreferrer">
                <span data-i18n="projects.viewRepo">{getUiText("projects.viewRepo")}</span>
              </a>
              {project.homepage && (
                <a
                  class="button button-secondary"
                  href={project.homepage}
                  target="_blank"
                  rel="noreferrer"
                >
                  <span data-i18n="projects.openSite">{getUiText("projects.openSite")}</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-shell split-grid">
    <div class="intro-slab">
      <div class="section-heading">
        <span class="eyebrow" data-i18n="projects.manual.eyebrow">
          {getUiText("projects.manual.eyebrow")}
        </span>
        <h2 class="headline" data-i18n="projects.manual.title">
          {getUiText("projects.manual.title")}
        </h2>
      </div>
      <p class="lede" data-i18n="projects.manual.lede">
        {getUiText("projects.manual.lede")}
      </p>
    </div>

    <div class="detail-list">
      <div class="detail-item">
        <div class="detail-kicker" data-i18n="projects.manual.reasonKicker">
          {getUiText("projects.manual.reasonKicker")}
        </div>
        <strong data-i18n="projects.manual.reasonText">
          {getUiText("projects.manual.reasonText")}
        </strong>
      </div>
      <div class="detail-item">
        <div class="detail-kicker" data-i18n="projects.manual.holdsKicker">
          {getUiText("projects.manual.holdsKicker")}
        </div>
        <strong data-i18n="projects.manual.holdsText">
          {getUiText("projects.manual.holdsText")}
        </strong>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="project-stack">
      {
        manualProjects.map((project) => (
          <article class="post-card project-card" style={`--accent: var(--${project.accent});`}>
            <div class="meta-row">
              <span class="tag tag--accent" data-i18n={`${project.i18nKey}.status`}>
                {getUiText(`${project.i18nKey}.status`)}
              </span>
              <span>{project.period}</span>
            </div>
            <h2 class="card-title" data-i18n={`${project.i18nKey}.title`}>
              {getUiText(`${project.i18nKey}.title`)}
            </h2>
            <p class="card-copy" data-i18n={`${project.i18nKey}.description`}>
              {getUiText(`${project.i18nKey}.description`)}
            </p>
            <div class="detail-kicker" data-i18n="projects.stack">
              {getUiText("projects.stack")}
            </div>
            <strong>{project.stack}</strong>
            <ul class="project-points">
              {project.highlights.map((_item, index) => (
                <li data-i18n={`${project.i18nKey}.highlight${index + 1}`}>
                  {getUiText(`${project.i18nKey}.highlight${index + 1}`)}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .profile-list,
  .project-points {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .project-grid,
  .project-stack {
    display: grid;
    gap: 1rem;
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-stack {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    gap: 1rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  @media (max-width: 900px) {
    .project-grid,
    .project-stack {
      grid-template-columns: 1fr;
    }
  }
</style>
