---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import CollectionGrid from "../../components/collections/CollectionGrid.astro";
import Tag from "../../components/ui/Tag.astro";
import { withBase } from "../../utils/links";
---

<BaseLayout
  title="Collections"
  description="Browse the six editorial shelves of Blooming Logs."
>
  <section class="section-shell">
    <div class="section-heading">
      <span class="eyebrow">Collections</span>
      <h1 class="headline">A small map of the house.</h1>
      <p class="lede">
        These six shelves are content collections, not the house-wide time
        index. If you want everything by date, open Archive.
      </p>
      <div class="tag-row" style="margin-top: 1rem;">
        <Tag label="Open Archive timeline" href={withBase("/archive")} accent />
      </div>
    </div>

    <CollectionGrid />
  </section>
</BaseLayout>
