---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import CollectionGrid from "../../components/collections/CollectionGrid.astro";
import { withBase } from "../../utils/links";
---

<BaseLayout
  title="旧栏目"
  description="按旧版栏目浏览 Focusmee 的历史文章。"
>
  <header class="page-header">
    <span class="section-label">Legacy collections</span>
    <h1>旧栏目</h1>
    <p>
      这些栏目为旧文章保留。新文章只使用标签，不再要求选择固定栏目。
      <a class="inline-link" href={withBase("/archive")}>也可以按时间查看归档</a>。
    </p>
  </header>

  <CollectionGrid />
</BaseLayout>
